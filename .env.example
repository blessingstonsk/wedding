# ─── Frontend (safe to expose — contains no secrets) ────────────────────────
# Turn guest wishes on once the backend below is set up.
VITE_BACKEND_ENABLED=false

# ─── Server-side only (Netlify → Site configuration → Environment variables) ─
# NEVER prefix these with VITE_ — that would bundle them into the website.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sign-in for the family dashboard at /admin. Use a strong password (12+ characters).
ADMIN_USERNAME=family
ADMIN_PASSWORD=choose-a-strong-password

# Random string used to hash guest IPs for rate limiting.
RATE_LIMIT_SALT=another-long-random-string

# Optional
WISHES_AUTO_APPROVE=false
# ALLOWED_ORIGIN=https://your-custom-domain.com
